        setDrop(target(ev.clientX, ev.clientY));
      }
      function up() {
        el.removeEventListener('pointermove', move);
        el.removeEventListener('pointerup', up);
        el.removeEventListener('pointercancel', up);
        if (!moved) { startEdit(n); return; }
        el.classList.remove('lifting');
        var t = dropT;
        setDrop(null);
        if (t) reparent(n, t);
        else if (n.p) layoutTree(rootOf(n).id);
        else drawLinks();
        save();
      }
      el.addEventListener('pointermove', move);
      el.addEventListener('pointerup', up);
      el.addEventListener('pointercancel', up);
    });

    nodeEls.set(n.id, el);
    return el;
  }

  /* =====================================================
     Sticky notes
     ===================================================== */
  function paint(n, el) {
    var c = catById(n.cat);
    el.style.left = n.x + 'px';
    el.style.top = n.y + 'px';
    el.style.zIndex = n.z;
    el.style.setProperty('--note', c.color);
    el.style.setProperty('--rot', rot(n.id) + 'deg');
    el.querySelector('.cat').textContent = c.label;
    el.querySelectorAll('.colors button').forEach(function (b) {
      b.setAttribute('aria-pressed', b.dataset.cat === n.cat ? 'true' : 'false');
    });
    el.classList.toggle('dim', filter.size > 0 && !filter.has(n.cat));
  }

  function repaintAll() {
    state.notes.forEach(function (n) { var el = els.get(n.id); if (el) paint(n, el); });
  }

  function front(n, el) { n.z = ++zTop; el.style.zIndex = n.z; }

  function makeNote(n) {
    var el = document.createElement('article');
    el.className = 'note';
    el.dataset.id = n.id;

    var grip = document.createElement('div');
    grip.className = 'grip';
    grip.tabIndex = 0;
    grip.title = 'Drag to move (arrow keys work too)';
    var lab = document.createElement('span');
    lab.className = 'cat';
    var del = document.createElement('button');
    del.type = 'button';
    del.className = 'del';
    del.setAttribute('aria-label', 'Delete note');
    del.textContent = '×';
    grip.appendChild(lab);
    grip.appendChild(del);

    var ta = document.createElement('textarea');
    ta.className = 'txt';
    ta.maxLength = 600;
    ta.placeholder = 'Write here…';
    ta.setAttribute('aria-label', 'Note text');
    ta.value = n.text;

    var colors = document.createElement('div');
    colors.className = 'colors';
    colors.setAttribute('role', 'group');
    colors.setAttribute('aria-label', 'Note category');
    CATS.forEach(function (c) {
      var b = document.createElement('button');
      b.type = 'button';
      b.style.background = c.color;
      b.title = c.label;
      b.setAttribute('aria-label', c.label);
      b.dataset.cat = c.id;
      b.addEventListener('click', function () { n.cat = c.id; paint(n, el); counts(); save(); });
      colors.appendChild(b);
    });

    el.appendChild(grip);
    el.appendChild(ta);
    el.appendChild(colors);

    ta.addEventListener('input', function () { n.text = ta.value; save(); });
    ta.addEventListener('focus', function () { front(n, el); save(); });

    del.addEventListener('pointerdown', function (e) { e.stopPropagation(); });
    del.addEventListener('click', function () {
      var i = state.notes.indexOf(n);
      if (i < 0) return;
      state.notes.splice(i, 1);
      el.remove();
      els.delete(n.id);
      counts();
      save();
      toast('Note deleted', 'Undo', function () {
        state.notes.splice(Math.min(i, state.notes.length), 0, n);
        canvas.appendChild(makeNote(n));
        counts();
        save();
      });
    });

    grip.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.del')) return;
      if (e.button !== undefined && e.button !== 0) return;
      e.preventDefault();
      grip.setPointerCapture(e.pointerId);
      front(n, el);
      var sx = e.clientX, sy = e.clientY, ox = n.x, oy = n.y;
      var sl = board.scrollLeft, st = board.scrollTop;
      el.classList.add('lifting');
      function move(ev) {
        var r = board.getBoundingClientRect();
        if (ev.clientX > r.right - 40) board.scrollLeft += 22;
        else if (ev.clientX < r.left + 40) board.scrollLeft -= 22;
        if (ev.clientY > r.bottom - 40) board.scrollTop += 22;
        else if (ev.clientY < r.top + 40) board.scrollTop -= 22;
        n.x = clamp(ox + (ev.clientX - sx) + (board.scrollLeft - sl), 0, CANVAS_W - NOTE_W);
        n.y = clamp(oy + (ev.clientY - sy) + (board.scrollTop - st), 0, CANVAS_H - NOTE_H);
        el.style.left = n.x + 'px';
        el.style.top = n.y + 'px';
      }
      function up() {
        grip.removeEventListener('pointermove', move);
        grip.removeEventListener('pointerup', up);
        grip.removeEventListener('pointercancel', up);
        el.classList.remove('lifting');
        save();
      }
      grip.addEventListener('pointermove', move);
      grip.addEventListener('pointerup', up);
      grip.addEventListener('pointercancel', up);
    });

    grip.addEventListener('keydown', function (e) {
      if (e.target !== grip) return;
      var d = { ArrowLeft: [-20, 0], ArrowRight: [20, 0], ArrowUp: [0, -20], ArrowDown: [0, 20] }[e.key];
      if (!d) return;
      e.preventDefault();
      n.x = clamp(n.x + d[0], 0, CANVAS_W - NOTE_W);
      n.y = clamp(n.y + d[1], 0, CANVAS_H - NOTE_H);
      paint(n, el);
      save();
    });

    els.set(n.id, el);
    paint(n, el);
    return el;
  }

  function freeSpot() {
    var x0 = board.scrollLeft + 24, y0 = board.scrollTop + 24;
    var sx = NOTE_W + 24, sy = NOTE_H + 24;
    var cols = Math.max(1, Math.floor((board.clientWidth - 24) / sx));
    var rows = Math.max(1, Math.floor((board.clientHeight - 24) / sy));
    for (var r = 0; r < rows; r++) {
      for (var c = 0; c < cols; c++) {
        var cx = x0 + c * sx, cy = y0 + r * sy;
        var taken = state.notes.some(function (n) { return Math.abs(n.x - cx) < 60 && Math.abs(n.y - cy) < 60; });
        if (!taken) return { x: clamp(cx, 0, CANVAS_W - NOTE_W), y: clamp(cy, 0, CANVAS_H - NOTE_H) };
      }
    }
    var j = (state.notes.length % 6) * 18;
    return { x: clamp(x0 + j, 0, CANVAS_W - NOTE_W), y: clamp(y0 + j, 0, CANVAS_H - NOTE_H) };
  }

  function addNote(text, cat, pos) {
    var p = pos ? { x: clamp(pos.x, 0, CANVAS_W - NOTE_W), y: clamp(pos.y, 0, CANVAS_H - NOTE_H) } : freeSpot();
    var n = { id: uid(), text: text, cat: cat, x: p.x, y: p.y, z: ++zTop };
    state.notes.push(n);
    var el = makeNote(n);
    el.classList.add('pop');
    canvas.appendChild(el);
    counts();
    save();
    return el;
  }

