        e.preventDefault();
        removeNode(n, true);
      }
    });
    el.addEventListener('keydown', function (e) {
      if (e.target !== el) return;
      if (e.key === 'Enter' || e.key === 'F2') { e.preventDefault(); startEdit(n); }
      else if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); removeNode(n, false); }
      else if (e.key === 'Tab' && e.shiftKey) { /* default focus move */ }
    });

    /* Drag a topic with its branches. Drop it on another topic to move the branch there. */
    el.addEventListener('pointerdown', function (e) {
      if (e.target.closest('button')) return;
      if (e.target === ta && el.classList.contains('editing')) return;
      if (e.button !== undefined && e.button !== 0) return;
      var sx = e.clientX, sy = e.clientY, sl = board.scrollLeft, st = board.scrollTop;
      var moved = false, group = null, bb = null, dropT = null, ids = {};
      try { el.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }

      function begin() {
        moved = true;
        if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
        el.classList.add('lifting');
        group = subtreeAll(n).map(function (g) { return { n: g, el: nodeEls.get(g.id), x: g.x, y: g.y }; });
        group.forEach(function (g) { ids[g.n.id] = 1; });
        bb = { minX: Infinity, maxX: 0, minY: Infinity, maxY: 0 };
        group.forEach(function (g) {
          bb.minX = Math.min(bb.minX, g.x); bb.maxX = Math.max(bb.maxX, g.x + g.el.offsetWidth);
          bb.minY = Math.min(bb.minY, g.y); bb.maxY = Math.max(bb.maxY, g.y + g.el.offsetHeight);
        });
      }
      function target(cx, cy) {
        for (var i = 0; i < state.nodes.length; i++) {
          var m = state.nodes[i];
          if (ids[m.id]) continue;
          var me = nodeEls.get(m.id);
          if (!me || me.hidden) continue;
          var r = me.getBoundingClientRect();
          if (cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom) return m;
        }
        return null;
      }
      function setDrop(t) {
        if (dropT === t) return;
        if (dropT && nodeEls.get(dropT.id)) nodeEls.get(dropT.id).classList.remove('drop');
        dropT = t;
        if (t) nodeEls.get(t.id).classList.add('drop');
      }
      function move(ev) {
        var dx = ev.clientX - sx, dy = ev.clientY - sy;
        if (!moved) { if (Math.hypot(dx, dy) < 5) return; begin(); }
        var r = board.getBoundingClientRect();
        if (ev.clientX > r.right - 40) board.scrollLeft += 22;
        else if (ev.clientX < r.left + 40) board.scrollLeft -= 22;
        if (ev.clientY > r.bottom - 40) board.scrollTop += 22;
        else if (ev.clientY < r.top + 40) board.scrollTop -= 22;
        var ddx = clamp(dx + (board.scrollLeft - sl), -bb.minX, CANVAS_W - bb.maxX);
        var ddy = clamp(dy + (board.scrollTop - st), -bb.minY, CANVAS_H - bb.maxY);
        group.forEach(function (g) {
          g.n.x = g.x + ddx; g.n.y = g.y + ddy;
          g.el.style.left = g.n.x + 'px'; g.el.style.top = g.n.y + 'px';
        });
