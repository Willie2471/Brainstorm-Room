  $('#copyBtn').addEventListener('click', function () {
    var lines = [], count = 0;
    var roots = state.nodes.filter(function (n) { return !n.p; }).sort(function (a, b) { return a.x - b.x; });
    function walk(n, d) {
      var t = n.text.trim() || '(empty topic)';
      lines.push(new Array(d + 1).join('  ') + '- ' + t);
      count++;
      kids(n.id).forEach(function (k) { walk(k, d + 1); });
    }
    if (roots.length) {
      lines.push('MIND MAP');
      roots.forEach(function (r) { walk(r, 0); });
      lines.push('');
    }
    CATS.forEach(function (c) {
      var ns = state.notes.filter(function (n) { return n.cat === c.id && n.text.trim(); });
      if (!ns.length) return;
      lines.push(c.label.toUpperCase());
      ns.forEach(function (n) { lines.push('- ' + n.text.trim().replace(/\s*\n+\s*/g, ' ')); count++; });
      lines.push('');
    });
    var txt = lines.join('\n').trim();
    if (!txt) { toast('Nothing to copy yet'); return; }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = txt;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      ta.remove();
      toast(ok ? 'Copied ' + count + ' items' : 'Couldn’t copy. Try the Backup button instead.');
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(txt).then(function () { toast('Copied ' + count + ' items'); }, fallback);
    } else { fallback(); }
  });

