    catEditBox.hidden = !editingCats;
    catEditBtn.textContent = editingCats ? 'Done' : 'Edit labels';
  });

  /* ---------- shared board sync ----------
     Every note, topic and the category names are stored one per row in a Google Sheet through an
     Apps Script web app. The page sends only what changed and merges in what other devices changed,
     so two people editing different things never overwrite each other. */
  function noteData(n) { return { text: n.text, cat: n.cat, x: Math.round(n.x), y: Math.round(n.y), z: n.z }; }
  function nodeData(n) {
    var o = { text: n.text, p: n.p, x: Math.round(n.x), y: Math.round(n.y), col: !!n.col };
    if (n.c !== undefined) o.c = n.c;
    return o;
  }
  function withId(data, id) {
    var o = {}, k;
    for (k in data) if (Object.prototype.hasOwnProperty.call(data, k)) o[k] = data[k];
    o.id = id;
    return o;
  }
  function noteBy(id) { return state.notes.filter(function (n) { return n.id === id; })[0]; }
  function collect() {
    var m = {};
    state.notes.forEach(function (n) { m[n.id] = { type: 'note', data: noteData(n) }; });
    state.nodes.forEach(function (n) { m[n.id] = { type: 'node', data: nodeData(n) }; });
    m.config = { type: 'config', data: catData() };
    Object.keys(m).forEach(function (k) { m[k].json = JSON.stringify(m[k].data); });
    return m;
  }
  function computeDiff() {
    var cur = collect(), ups = [], dels = [], k;
    Object.keys(cur).forEach(function (id) {
      if (synced[id] !== cur[id].json) ups.push({ id: id, type: cur[id].type, data: cur[id].data, json: cur[id].json });
    });
    Object.keys(synced).forEach(function (id) { if (!cur[id]) dels.push({ id: id, del: 1 }); });
    return { ups: ups, dels: dels };
  }

  function setStatus(t) { statusEl.textContent = t; }
  function fetchJson(url, opts) {
    var timer, timeout = new Promise(function (resolve, reject) {
      timer = setTimeout(function () { reject(new Error('The shared board took too long to answer')); }, 25000);
    });
    var req = fetch(url, opts).then(function (r) {
      if (!r.ok) throw new Error('The shared board answered with an error (' + r.status + ')');
      return r.text();
    }).then(function (txt) {
      var j;
      try { j = JSON.parse(txt); } catch (e) {
        throw new Error('Not a sync response. Check the web app URL and that access is set to Anyone.');
      }
      if (!j.ok) throw new Error(j.error || 'The shared board refused the request');
      return j;
    });
    return Promise.race([req, timeout]).then(function (j) { clearTimeout(timer); return j; }, function (e) { clearTimeout(timer); throw e; });
  }
  function getRemote(params) {
    var url = SYNC_URL + '?key=' + encodeURIComponent(SYNC_KEY) + '&t=' + Date.now() + '&' + params;
    return fetchJson(url, { method: 'GET' });
  }
  function postRemote(items) {
    return fetchJson(SYNC_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ key: SYNC_KEY, action: 'save', since: Math.max(0, lastSync - 5000), items: items })
    });
  }

  function removeNoteLocal(n) {
    var i = state.notes.indexOf(n);
    if (i >= 0) state.notes.splice(i, 1);
    var el = els.get(n.id);
    if (el) el.remove();
    els.delete(n.id);
  }
  function removeNodeLocal(m) {
    var i = state.nodes.indexOf(m);
    if (i >= 0) state.nodes.splice(i, 1);
    destroyNodeEl(m);
  }

  // Merge what the server has into the board. Anything edited here and not yet sent wins.
  function applyBatch(items, full) {
    var notesTouched = false, nodesTouched = false, serverIds = {};
    items.forEach(function (it) {
      var id = String(it.id);
      if (!it.del) serverIds[id] = 1;
      if (it.del) {
        var dn = noteBy(id), dm = byId(id);
        if (dn && (!(id in synced) || JSON.stringify(noteData(dn)) === synced[id])) { removeNoteLocal(dn); notesTouched = true; }
        if (dm && (!(id in synced) || JSON.stringify(nodeData(dm)) === synced[id])) { removeNodeLocal(dm); nodesTouched = true; }
        if (!dn && !dm) delete synced[id];
        else if (!noteBy(id) && !byId(id)) delete synced[id];
        return;
      }
      if (it.type === 'config') {
        // Names edited here and not yet sent win; they go up on the next push.
        if ('config' in synced && JSON.stringify(catData()) !== synced.config) { synced.config = '~stale'; return; }
        applyConfig(it.data);
        synced.config = JSON.stringify(catData());
        return;
      }
      if (it.type === 'note') {
        var obj = cleanNote(withId(it.data || {}, id));
        var json = JSON.stringify(noteData(obj));
        var n = noteBy(id);
        if (n) {
          var mine = JSON.stringify(noteData(n));
          if (id in synced && mine !== synced[id]) { synced[id] = json; return; }
          if (mine === json) { synced[id] = json; return; }
          n.text = obj.text; n.cat = obj.cat; n.x = obj.x; n.y = obj.y; n.z = obj.z;
          zTop = Math.max(zTop, obj.z);
          var nel = els.get(id);
          paint(n, nel);
          var nta = nel.querySelector('.txt');
          if (nta.value !== n.text) nta.value = n.text;
        } else {
          state.notes.push(obj);
          zTop = Math.max(zTop, obj.z);
          canvas.appendChild(makeNote(obj));
        }
        synced[id] = json;
        notesTouched = true;
      } else if (it.type === 'node') {
        var nobj = cleanNode(withId(it.data || {}, id));
        var njson = JSON.stringify(nodeData(nobj));
        var m = byId(id);
        if (m) {
          var mmine = JSON.stringify(nodeData(m));
          if (id in synced && mmine !== synced[id]) { synced[id] = njson; return; }
          if (mmine === njson) { synced[id] = njson; return; }
          m.text = nobj.text; m.p = nobj.p; m.x = nobj.x; m.y = nobj.y; m.col = nobj.col;
          if (nobj.c !== undefined) m.c = nobj.c; else delete m.c;
          var mel = nodeEls.get(id);
          var mta = mel.querySelector('.ntxt');
          if (mta.value !== m.text) mta.value = m.text;
        } else {
          state.nodes.push(nobj);
          maplayer.appendChild(makeNodeEl(nobj));
        }
        synced[id] = njson;
        nodesTouched = true;
      }
    });
    if (full) {
      // On a full load, anything we knew was on the server but is gone now was deleted by someone else.
      state.notes.slice().forEach(function (n) {
        if (!serverIds[n.id] && (n.id in synced)) {
          if (JSON.stringify(noteData(n)) === synced[n.id]) { removeNoteLocal(n); notesTouched = true; }
          delete synced[n.id];
        }
      });
      state.nodes.slice().forEach(function (m) {
        if (!serverIds[m.id] && (m.id in synced)) {
          if (JSON.stringify(nodeData(m)) === synced[m.id]) { removeNodeLocal(m); nodesTouched = true; }
          delete synced[m.id];
        }
      });
    }
    if (nodesTouched) {
      syncVisibility();
      state.nodes.forEach(paintNode);
      drawLinks();
    }
    if (notesTouched || nodesTouched) counts();
  }

  function schedulePush(ms) {
    clearTimeout(syncT);
    syncT = setTimeout(function () { syncNow(false); }, ms);
  }

  function syncNow(full) {
    if (!SYNC_ON) return;
    if (inflight) { again = true; return; }
    inflight = true;
    clearTimeout(syncT);
    setStatus('Syncing…');
    var diff = full ? { ups: [], dels: [] } : computeDiff();
    var req;
    if (diff.ups.length || diff.dels.length) {
      var items = diff.ups.map(function (u) { return { id: u.id, type: u.type, data: u.data, del: 0 }; })
        .concat(diff.dels);
      req = postRemote(items).then(function (res) {
        diff.ups.forEach(function (u) { synced[u.id] = u.json; });
        diff.dels.forEach(function (d) { delete synced[d.id]; });
        return res;
      });
    } else {
      req = getRemote(full ? 'action=load' : 'action=sync&since=' + Math.max(0, lastSync - 5000));
    }
    req.then(function (res) {
      applyBatch(res.items || [], full);
      lastSync = res.now || lastSync;
      loadedOnce = true;
      counts();
      setStatus('Shared · synced ' + clock());
      flush();
      if (full) schedulePush(200);
    }).catch(function (err) {
      loadedOnce = true;
      counts();
      setStatus('Not synced: ' + String(err && err.message ? err.message : 'offline').replace(/\.$/, '') + '. Changes are kept on this device.');
      schedulePush(20000);
    }).then(function () {
      inflight = false;
      if (again) { again = false; schedulePush(300); }
    });
  }

  /* ---------- start ---------- */
  buildSwatches();
  buildChips();
  state.nodes.forEach(function (n) { maplayer.appendChild(makeNodeEl(n)); });
  state.notes.forEach(function (n) { canvas.appendChild(makeNote(n)); });
  syncVisibility();
  if (fresh) layoutAll();
  else { state.nodes.forEach(paintNode); drawLinks(); }
  counts();
  if (storageOK) flush();
  else statusEl.textContent = 'This browser won’t save. Use Backup to keep a copy.';
  // Web fonts change text widths, so re-measure once they arrive.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function () {
      if (fresh) { layoutAll(); save(); }
      else { state.nodes.forEach(paintNode); drawLinks(); }
    });
  }
  if (SYNC_ON) {
    syncBtn.hidden = false;
    syncBtn.addEventListener('click', function () { syncNow(false); });
    setStatus('Connecting to the shared board…');
    syncNow(true);
    setInterval(function () {
      if (document.visibilityState === 'visible' && !inflight) syncNow(false);
    }, POLL_MS);
    window.addEventListener('online', function () { syncNow(false); });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') { syncNow(false); return; }
      // Leaving the page: send anything still waiting so it is not lost.
      if (inflight) return;
      var d = computeDiff();
      if (!d.ups.length && !d.dels.length) return;
      var items = d.ups.map(function (u) { return { id: u.id, type: u.type, data: u.data, del: 0 }; }).concat(d.dels);
      try {
        fetch(SYNC_URL, {
          method: 'POST', keepalive: true,
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ key: SYNC_KEY, action: 'save', since: Date.now() + 60000, items: items })
        }).catch(function () { /* the next visit sends it again */ });
      } catch (e) { /* ignore */ }
    });
  }
})();
</script>
