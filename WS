    el.dataset.id = n.id;
    el.tabIndex = 0;
    el.setAttribute('role', 'group');
    el.setAttribute('aria-label', 'Mind map topic');

    var grow = document.createElement('div');
    grow.className = 'grow';
    var rep = document.createElement('span');
    rep.className = 'rep';
