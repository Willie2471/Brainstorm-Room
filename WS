    var ta = document.createElement('textarea');
    ta.className = 'ntxt';
    ta.rows = 1;
    ta.maxLength = 200;
    ta.spellcheck = true;
    ta.setAttribute('aria-label', 'Topic text');
    ta.value = n.text;
    grow.appendChild(rep);
    grow.appendChild(ta);
    el.appendChild(grow);

    function mkBtn(cls, label, text) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'nb ' + cls;
      b.setAttribute('aria-label', label);
      b.title = label;
      b.textContent = text;
      el.appendChild(b);
      return b;
    }
    var addB = mkBtn('add', 'Add a branch', '+');
    var foldB = mkBtn('fold', 'Hide branches', '−');
    var rmB = mkBtn('rm', 'Delete topic and its branches', '×');

    addB.addEventListener('click', function () { addNode(n.id); });
    foldB.addEventListener('click', function () { n.col = !n.col; layoutTree(rootOf(n).id); save(); });
    rmB.addEventListener('click', function () { removeNode(n, false); });

    var lastW = 0;
    ta.addEventListener('focus', function () { hintShow(true); lastW = el.offsetWidth; });
    ta.addEventListener('blur', function () {
      el.classList.remove('editing');
      hintShow(false);
    });
    ta.addEventListener('input', function () {
      if (/\n/.test(ta.value)) ta.value = ta.value.replace(/\s*\n\s*/g, ' ');
      n.text = ta.value;
      rep.textContent = (ta.value || ta.placeholder) + '​';
