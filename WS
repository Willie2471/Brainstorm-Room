      save();
    });
  }

  function reparent(n, target) {
    var oldRoot = rootOf(n);
    if (target.id === n.p) { layoutTree(rootOf(target).id); return; }
    n.p = target.id;
    target.col = false;
    n.x = CANVAS_W;
    if (!target.p) n.c = pickColor(target.id); else delete n.c;
    layoutTree(rootOf(target).id);
    if (oldRoot.id !== n.id && byId(oldRoot.id)) layoutTree(oldRoot.id);
  }

  function hintShow(on) { hintEl.hidden = !on; }

  function makeNodeEl(n) {
    var el = document.createElement('div');
