  function catData() {
    return { cats: CATS.map(function (c) { return { id: c.id, label: c.label, color: c.color }; }) };
  }
  function applyConfig(cfg) {
    if (!cfg || !Array.isArray(cfg.cats)) return;
    cfg.cats.forEach(function (x) {
      var c = CATS.filter(function (k) { return x && k.id === x.id; })[0];
      if (!c) return;
      if (x.label && String(x.label).trim()) c.label = String(x.label).trim().slice(0, 18);
      if (typeof x.color === 'string' && /^#[0-9a-fA-F]{6}$/.test(x.color)) c.color = x.color;
